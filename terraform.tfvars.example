# ==============================================================================
# Hetzner Cloud Terraform Configuration Variables
# ==============================================================================
# Quick Start:
#   1. Copy this file to terraform.tfvars:
#      cp terraform.tfvars.example terraform.tfvars
#   2. Enter your Hetzner API token below.
#   3. Run terraform init && terraform apply
#
# Note: terraform.tfvars is in .gitignore so your token stays completely private!
# ==============================================================================

# 1. Hetzner Cloud API Token (Required)
# Generate from: https://console.hetzner.cloud -> Project -> Security -> API Tokens (Read & Write)
hcloud_token = "YOUR_HETZNER_API_TOKEN_HERE"

# 2. Your SSH Public Key (required for emergency access)
# Example: "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... user@machine"
ssh_public_key = ""

# 2.1 SSH Allowed IP Ranges (Security Hardening)
# Restrict port 22 access exclusively to your own public IP address for maximum security.
# Example: allowed_ssh_ips = ["203.0.113.10/32"]
allowed_ssh_ips = [
  "203.0.113.10/32"
]

# 3. Server Specifications (one Hetzner Cloud VPS)
# cx23 = 2 vCPU, 4 GB RAM
server_size   = "cx23"
server_region = "fsn1"          # Falkenstein (Germany). Options: fsn1, nbg1, hel1, ash, hil
server_image  = "ubuntu-24.04"

# 4. Platform settings
server_name       = "lmbek-k3s"
admin_username    = "k3sadmin"
domain            = "lmbek.dk"
letsencrypt_email = "admin@example.com"

# Generate immediately before terraform apply:
# gh api --method POST repos/lmbek/lmbek-hobby-platform/actions/runners/registration-token --jq .token
# This token is single-use and expires after one hour; it is not a long-lived deployment credential.
github_runner_token  = "ONE_TIME_RUNNER_REGISTRATION_TOKEN"
github_repository_url = "https://github.com/lmbek/lmbek-hobby-platform"
